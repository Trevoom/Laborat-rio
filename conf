          color: "rgba(50, 172, 45, 0.9)"
          level: 0

    # ============================================================
    # REGRA 4: CONEXÕES / TÚNEIS VPN MATRIZ CMP
    # ============================================================
    - name: "Links VPN - Matriz CMP"
      pattern: "/.*vpn_cmp.*/"
      type: "number"
